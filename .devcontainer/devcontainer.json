{
  "name": "HamZa Android Development",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-tools.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "msjsdiag.vscode-react-native",
        "redhat.vscode-yaml"
      ]
    }
  },
  "remoteUser": "vscode"
}
