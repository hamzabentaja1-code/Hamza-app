{
  "expo": {
    "name": "HamZa",
    "slug": "hamza-app",
    "version": "0.8.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": false,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح لـ HamZa باختيار صور المنتجات من جهازك."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "السماح لـ HamZa باستعمال الميكروفون للبحث عن المنتجات بالصوت.",
          "speechRecognitionPermission": "السماح لـ HamZa بتحويل الكلام إلى كلمات للبحث عن المنتجات.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"]
        }
      ]
    ],
    "android": {
      "package": "com.hamza.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
